APP_NAME=DocuMind AI
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=mysql+pymysql://YOUR_USER:YOUR_PASSWORD@localhost:3306/documind_ai

LLM_PROVIDER=groq
LLM_MODEL=replace-with-a-supported-model-name
GROQ_API_KEY=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=5

MAX_UPLOAD_MB=15
MIN_RETRIEVAL_SCORE=